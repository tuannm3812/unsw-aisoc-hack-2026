# Copy to .env at the repo root. Every value is optional: the app runs without any of
# them, degrading to a deterministic fallback brief and a canvas-only task.

# --- Mistral -----------------------------------------------------------------
# Without this, document drop still stores the file but extracts nothing, and task
# briefs fall back to a deterministic summary of the lineage.
# Model names are pinned, and Mistral retires dated snapshots. After setting the key,
# run GET /api/integrations/mistral/verify to confirm both names are still live.
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-4-0
MISTRAL_TEXT_MODEL=mistral-medium-3-5

# --- Jira Cloud --------------------------------------------------------------
# A free Cloud site is enough. Create the token at
# https://id.atlassian.com/manage-profile/security/api-tokens
# Without these, assignment still works and the task stays canvas-only.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SB
JIRA_ISSUE_TYPE=Task

# --- MCP ---------------------------------------------------------------------
# Bearer token coding agents present. Change it before showing anyone the URL.
MCP_TOKEN=dev-mcp-token

# --- Notifications (optional) ------------------------------------------------
# Unset means assignment events are logged to the server console instead.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# --- Session -----------------------------------------------------------------
SESSION_SECRET=dev-only-change-me
